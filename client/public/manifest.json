{
  "name": "shelf.it",
  "short_name": "shelf.it",
  "start_url": "/shelfit/",
  "scope": "/shelfit/",
  "display": "standalone",
  "background_color": "#0a0a0a",
  "theme_color": "#0a0a0a",
  "icons": [
    { "src": "/shelfit/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/shelfit/icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/shelfit/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Cerca",
      "url": "/shelfit/search",
      "icons": [{ "src": "/shelfit/icons/shortcuts/search.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Prossimamente",
      "url": "/shelfit/upcoming",
      "icons": [{ "src": "/shelfit/icons/shortcuts/upcoming.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Rate-O-Matic",
      "url": "/shelfit/?open=rate",
      "icons": [{ "src": "/shelfit/icons/shortcuts/rate.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "share_target": {
    "action": "/shelfit/share",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "url": "url",
      "title": "title",
      "text": "text"
    }
  }
}
