# shelfIt environment configuration
#
# Copy this file to `.env` and fill in the values. `.env` is git-ignored and is
# read at container startup by docker-compose. Only TMDB_API_KEY and (for a
# publicly reachable instance) APP_PASSWORD are strictly required; everything
# else has a sensible default.

# =============================================================================
# Required
# =============================================================================

# The Movie Database API key. Powers all search, metadata and artwork.
# Create a free account at https://www.themoviedb.org/ and request an API key
# under Settings -> API. Accepts a v3 API key.
TMDB_API_KEY=insert_your_key_here

# Password of the MASTER account: the one that manages the household and the
# instance. Set this before the first boot: it is hashed (scrypt) into the
# database on startup, after which it may be removed from .env. Household members
# get their own accounts later, from Settings > Household, and choose their own
# passwords through a one-time invite link.
# In production the server REFUSES to start without a password unless
# ALLOW_NO_AUTH=true is set. Required unless ALLOW_NO_AUTH=true.
APP_PASSWORD=choose_a_strong_password

# =============================================================================
# Optional — authentication
# =============================================================================

# Change the master password: set this to true together with a new APP_PASSWORD,
# boot once, then remove both lines. It also signs the master out of every device.
# Members' passwords are reset from Settings > Household instead. Default: false.
# APP_PASSWORD_RESET=true

# Intentionally run the instance with NO login gate (e.g. a trusted LAN-only
# deployment): every request acts as the master. Default: false. Do not enable on
# a publicly reachable instance.
# ALLOW_NO_AUTH=true

# =============================================================================
# Optional — networking
# =============================================================================

# Port the Node server listens on inside the container. Default: 3000.
PORT=3000

# Origin your other devices reach the app at (no trailing slash, no sub-path):
# the host's Tailscale name in the recommended setup, or a DDNS hostname behind
# port forwarding. Used to build magic-link and invite URLs and as the only
# non-localhost CORS origin. When unset, magic links fall back to the
# host/scheme forwarded on the incoming request.
# PUBLIC_URL=https://myserver.tail1234.ts.net

# =============================================================================
# Optional — metadata & caching
# =============================================================================

# Fanart.tv API key. Enables higher-quality clear logos and extra artwork.
# Optional — the app works without it. Get one at https://fanart.tv/get-an-api-key/
FANART_API_KEY=insert_your_fanart_tv_key_here

# How long cached movie / show metadata is considered fresh before a background
# refresh. Movies rarely change, shows gain episodes, hence the different
# defaults. Values are in days. Defaults: 180 (movies), 7 (shows).
CACHE_MAX_AGE_DAYS_MOVIES=180
CACHE_MAX_AGE_DAYS_SHOWS=7

# Time-to-live (minutes) for the cached "Explore" discovery rows. Default: 90.
# EXPLORE_TTL_MIN=90

# =============================================================================
# Optional — web push notifications
# =============================================================================

# Contact address embedded in the VAPID header sent to push services (RFC 8292).
# The VAPID keypair itself is generated once and stored in the database, not
# here. Default: mailto:shelfit@example.com.
# VAPID_SUBJECT=mailto:you@example.com
